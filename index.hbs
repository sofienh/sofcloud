<section class="sc-status-section">
  <div class="sc-status-label">
    <span id="kuma-dot" class="sc-status-dot up"></span>
    <span>Infrastructure — sofcloud.org</span>
    <a href="https://kuma.sofcloud.org/status/sofcloud" target="_blank" rel="noopener" class="sc-status-link">voir tout ↗</a>
  </div>
  <div class="sc-status-card">
    <div class="sc-status-main">
      <span id="kuma-status-text" class="sc-status-text up">Opérationnel</span>
      <div class="sc-status-stats">
        <div class="sc-stat"><span class="sc-stat-val" id="kuma-ping">—</span><span class="sc-stat-lbl">ms</span></div>
        <div class="sc-stat"><span class="sc-stat-val" id="kuma-uptime24">—</span><span class="sc-stat-lbl">uptime</span></div>
      </div>
    </div>
    <div class="sc-kuma-chart-wrap">
      <canvas id="kuma-chart"></canvas>
    </div>
  </div>
</section>

<div class="sc-space-banner" aria-hidden="true">
  <canvas id="banner-stars"></canvas>
  <div class="sc-banner-scaler">
    <img src="{{asset "astronaute.svg"}}" alt="" fetchpriority="high">
  </div>
</div>
<script>
(function() {
  var c = document.getElementById('banner-stars');
  if (!c) return;
  var ctx = c.getContext('2d'), stars = [], W = 0, H = 0;
  function init() {
    stars = [];
    for (var i = 0; i < 180; i++) {
      stars.push({ x: Math.random()*W, y: Math.random()*H, r: Math.random()*1.2+0.2, o: Math.random()*0.7+0.2, do: (Math.random()-0.5)*0.007 });
    }
  }
  function draw() {
    if (W && H) {
      ctx.clearRect(0,0,W,H);
      for (var i=0;i<stars.length;i++) {
        var s=stars[i]; s.o+=s.do; if(s.o>0.9||s.o<0.1) s.do*=-1;
        ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
        ctx.fillStyle='rgba(255,255,255,'+s.o.toFixed(2)+')'; ctx.fill();
      }
    }
    requestAnimationFrame(draw);
  }
  new ResizeObserver(function(e) { var r=e[0].contentRect; W=c.width=Math.round(r.width); H=c.height=Math.round(r.height); init(); }).observe(c.parentElement);
  draw();
})();
</script>

<style>
.sc-planet-home { position: absolute; right: -4vw; top: 0; bottom: 0; display: flex; align-items: center; pointer-events: none; z-index: 0; overflow: hidden; clip-path: inset(0); }
.sc-planet-moon {
  display: block; width: 34vw; max-width: 440px; opacity: 0.28;
  mask-image: radial-gradient(ellipse at center, black 40%, transparent 72%);
  -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 72%);
  animation: planet-drift-home 22s ease-in-out infinite;
}
@keyframes planet-drift-home { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
.sc-status-section { max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--layout-pad); position: relative; z-index: 2; }
.sc-kuma-chart-wrap { margin-top: 1rem; position: relative; height: var(--kuma-chart-h, 120px); overflow: hidden; border-radius: 6px; }
.sc-status-label {
  display: flex; align-items: center; gap: 0.6rem;
  font-family: var(--mono,'DM Mono',monospace); font-size: 0.72rem;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  margin-bottom: 0.75rem;
}
.sc-status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); flex-shrink: 0; }
.sc-status-dot.up { background: var(--accent); animation: pulse 2s infinite; }
.sc-status-dot.down { background: var(--red); }
.sc-status-link { margin-left: auto; color: var(--accent); text-decoration: none; font-size: 0.7rem; }
.sc-status-link:hover { color: var(--accent-light); }
.sc-status-card {
  background: rgba(3, 10, 6, 0.88);
  backdrop-filter: blur(1px); -webkit-backdrop-filter: blur(1px);
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 4px 24px rgba(0,0,0,0.6);
  border-radius: 12px; padding: 1.25rem 1.5rem;
}
.sc-status-main { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
.sc-status-text { font-family: var(--mono,'DM Mono',monospace); font-size: 0.85rem; color: var(--accent); }
.sc-status-text.up { color: var(--accent); }
.sc-status-text.down { color: var(--red); }
.sc-status-stats { display: flex; gap: 1.5rem; }
.sc-stat { display: flex; flex-direction: column; align-items: flex-end; }
.sc-stat-val { font-family: var(--mono,'DM Mono',monospace); font-size: 1rem; font-weight: 600; color: var(--accent); }
.sc-stat-lbl { font-family: var(--mono,'DM Mono',monospace); font-size: 0.65rem; color: var(--accent); text-transform: uppercase; }
</style>

<script>
(function() {

  function setStatus(up) {
    var dot = document.getElementById('kuma-dot');
    var txt = document.getElementById('kuma-status-text');
    dot.className = 'sc-status-dot ' + (up ? 'up' : 'down');
    txt.className = 'sc-status-text ' + (up ? 'up' : 'down');
    txt.textContent = up ? 'Opérationnel' : 'Hors ligne';
  }

  function drawChart(canvas, beats) {
    var W = canvas.parentElement.offsetWidth || 800;
    var accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#34d399';
    var H = 120;
    var dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
    var ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    var pings = beats.map(function(b) { return b.ping; });
    var max = Math.max.apply(null, pings.filter(function(p){ return p != null; })) || 1;
    var pad = { top: 8, bot: 28, left: 40, right: 8 };
    var cw = W - pad.left - pad.right;
    var ch = H - pad.top - pad.bot;
    var n = beats.length;
    var step = cw / (n - 1 || 1);

    // Grille
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1].forEach(function(r) {
      var y = pad.top + ch * (1 - r);
      ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + cw, y); ctx.stroke();
    });

    // Labels Y
    ctx.fillStyle = accentColor;
    ctx.font = '10px DM Mono, monospace';
    ctx.textAlign = 'right';
    [0, Math.round(max/2), Math.round(max)].forEach(function(v) {
      var y = pad.top + ch * (1 - v / max);
      ctx.fillText(v, pad.left - 4, y + 3);
    });

    // Labels X (adaptatif selon largeur)
    ctx.fillStyle = accentColor;
    ctx.textAlign = 'center';
    var maxLabels = Math.min(6, Math.max(2, Math.floor(cw / 75)));
    var step6 = Math.max(1, Math.floor(n / maxLabels));
    beats.forEach(function(b, i) {
      if (i % step6 !== 0 && i !== n - 1) return;
      var t = new Date(b.time.replace(' ', 'T') + 'Z');
      var lbl = t.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
      var x = pad.left + i * step;
      ctx.fillText(lbl, x, H - 6);
    });

    // Zones rouges (down)
    beats.forEach(function(b, i) {
      if (b.status !== 0) return;
      var x = pad.left + i * step - step / 2;
      ctx.fillStyle = 'rgba(239,68,68,0.3)';
      ctx.fillRect(Math.max(pad.left, x), pad.top, step, ch);
    });

    // Courbe ping
    ctx.beginPath();
    var started = false;
    beats.forEach(function(b, i) {
      if (b.ping == null) return;
      var x = pad.left + i * step;
      var y = pad.top + ch * (1 - b.ping / max);
      if (!started) { ctx.moveTo(x, y); started = true; } else { ctx.lineTo(x, y); }
    });
    ctx.strokeStyle = accentColor;
    ctx.lineWidth = 1.5;
    ctx.lineJoin = 'round';
    ctx.stroke();

    // Remplissage
    if (started) {
      ctx.lineTo(pad.left + (n - 1) * step, pad.top + ch);
      ctx.lineTo(pad.left, pad.top + ch);
      ctx.closePath();
      ctx.fillStyle = 'rgba(52,211,153,0.07)'; /* accent avec opacité fixe — intentionnel */
      ctx.fill();
    }
  }

  function _fetchKuma() {
    fetch('/content/files/kuma-status.json?t=' + Date.now())
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var beats = data.beats || [];
      setStatus(data.status === 1);
      document.getElementById('kuma-ping').textContent = data.ping != null ? data.ping : '—';
      document.getElementById('kuma-uptime24').textContent = data.uptime != null ? data.uptime + '%' : '—';
      if (beats.length) {
        setTimeout(function() {
          drawChart(document.getElementById('kuma-chart'), beats);
        }, 100);
      }
    })
    .catch(function() { setStatus(true); });
  }
  if (window.requestIdleCallback) {
    requestIdleCallback(_fetchKuma, { timeout: 3000 });
  } else {
    window.addEventListener('load', function() { setTimeout(_fetchKuma, 200); });
  }
})();
</script>

<script>
(function() {
  var c = document.getElementById('hero-stars');
  if (!c) return;
  var ctx = c.getContext('2d'), stars = [], W = 0, H = 0;
  function init() {
    stars = [];
    for (var i = 0; i < 100; i++) {
      stars.push({ x: Math.random()*W, y: Math.random()*H, r: Math.random()*1.1+0.2, o: Math.random()*0.6+0.2, do: (Math.random()-0.5)*0.008 });
    }
  }
  function draw() {
    if (W && H) {
      ctx.clearRect(0,0,W,H);
      for (var i=0;i<stars.length;i++) {
        var s=stars[i]; s.o+=s.do; if(s.o>0.85||s.o<0.1) s.do*=-1;
        ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
        ctx.fillStyle='rgba(255,255,255,'+s.o.toFixed(2)+')'; ctx.fill();
      }
    }
    requestAnimationFrame(draw);
  }
  new ResizeObserver(function(e) { var r=e[0].contentRect; W=c.width=Math.round(r.width); H=c.height=Math.round(r.height); init(); }).observe(c.parentElement);
  draw();
})();
</script>



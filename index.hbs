<section class="sc-status-section">
  <div class="sc-status-label">
    <span id="kuma-dot" class="sc-status-dot"></span>
    <span>Infrastructure — sofcloud.org</span>
    <a href="https://kuma.sofcloud.org/status/sofcloud" target="_blank" rel="noopener" class="sc-status-link">voir tout ↗</a>
  </div>
  <div class="sc-status-card">
    <div class="sc-status-main">
      <span id="kuma-status-text" class="sc-status-text">Chargement…</span>
      <div class="sc-status-stats">
        <div class="sc-stat"><span class="sc-stat-val" id="kuma-ping">—</span><span class="sc-stat-lbl">ms</span></div>
        <div class="sc-stat"><span class="sc-stat-val" id="kuma-uptime24">—</span><span class="sc-stat-lbl">uptime</span></div>
      </div>
    </div>
    <div style="margin-top:1rem;position:relative;height:120px;">
      <canvas id="kuma-chart"></canvas>
    </div>
  </div>
</section>

<style>
.sc-status-section { max-width: 1400px; margin: 0 auto 3rem; padding: 0 3rem; }
.sc-status-label {
  display: flex; align-items: center; gap: 0.6rem;
  font-family: var(--mono,'DM Mono',monospace); font-size: 0.72rem;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  margin-bottom: 0.75rem;
}
.sc-status-dot { width: 7px; height: 7px; border-radius: 50%; background: #64748b; flex-shrink: 0; }
.sc-status-dot.up { background: #34d399; animation: pulse 2s infinite; }
.sc-status-dot.down { background: #ef4444; }
.sc-status-link { margin-left: auto; color: var(--text-muted,#64748b); text-decoration: none; font-size: 0.7rem; }
.sc-status-link:hover { color: var(--accent); }
.sc-status-card {
  background: var(--surface,#0f1a14); border: 1px solid var(--border,#1a2d22);
  border-radius: 12px; padding: 1.25rem 1.5rem;
}
.sc-status-main { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
.sc-status-text { font-family: var(--mono,'DM Mono',monospace); font-size: 0.85rem; color: #64748b; }
.sc-status-text.up { color: #34d399; }
.sc-status-text.down { color: #ef4444; }
.sc-status-stats { display: flex; gap: 1.5rem; }
.sc-stat { display: flex; flex-direction: column; align-items: flex-end; }
.sc-stat-val { font-family: var(--mono,'DM Mono',monospace); font-size: 1rem; font-weight: 600; color: var(--accent); }
.sc-stat-lbl { font-family: var(--mono,'DM Mono',monospace); font-size: 0.65rem; color: #64748b; text-transform: uppercase; }
</style>

<script>
(function() {

  function setStatus(up) {
    var dot = document.getElementById('kuma-dot');
    var txt = document.getElementById('kuma-status-text');
    dot.className = 'sc-status-dot ' + (up ? 'up' : 'down');
    txt.className = 'sc-status-text ' + (up ? 'up' : 'down');
    txt.textContent = up ? 'Opérationnel' : 'Hors ligne';
  }

  function drawChart(canvas, beats) {
    var W = canvas.parentElement.offsetWidth || 800;
    var H = 120;
    var dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
    var ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);

    var pings = beats.map(function(b) { return b.ping; });
    var max = Math.max.apply(null, pings.filter(function(p){ return p != null; })) || 1;
    var pad = { top: 8, bot: 28, left: 40, right: 8 };
    var cw = W - pad.left - pad.right;
    var ch = H - pad.top - pad.bot;
    var n = beats.length;
    var step = cw / (n - 1 || 1);

    // Grille
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    [0.25, 0.5, 0.75, 1].forEach(function(r) {
      var y = pad.top + ch * (1 - r);
      ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + cw, y); ctx.stroke();
    });

    // Labels Y
    ctx.fillStyle = '#475569';
    ctx.font = '10px DM Mono, monospace';
    ctx.textAlign = 'right';
    [0, Math.round(max/2), Math.round(max)].forEach(function(v) {
      var y = pad.top + ch * (1 - v / max);
      ctx.fillText(v, pad.left - 4, y + 3);
    });

    // Labels X (6 max)
    ctx.textAlign = 'center';
    var step6 = Math.max(1, Math.floor(n / 6));
    beats.forEach(function(b, i) {
      if (i % step6 !== 0 && i !== n - 1) return;
      var t = new Date(b.time.replace(' ', 'T') + 'Z');
      var lbl = t.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
      var x = pad.left + i * step;
      ctx.fillText(lbl, x, H - 6);
    });

    // Zones rouges (down)
    beats.forEach(function(b, i) {
      if (b.status !== 0) return;
      var x = pad.left + i * step - step / 2;
      ctx.fillStyle = 'rgba(239,68,68,0.3)';
      ctx.fillRect(Math.max(pad.left, x), pad.top, step, ch);
    });

    // Courbe ping
    ctx.beginPath();
    var started = false;
    beats.forEach(function(b, i) {
      if (b.ping == null) return;
      var x = pad.left + i * step;
      var y = pad.top + ch * (1 - b.ping / max);
      if (!started) { ctx.moveTo(x, y); started = true; } else { ctx.lineTo(x, y); }
    });
    ctx.strokeStyle = '#34d399';
    ctx.lineWidth = 1.5;
    ctx.lineJoin = 'round';
    ctx.stroke();

    // Remplissage
    if (started) {
      ctx.lineTo(pad.left + (n - 1) * step, pad.top + ch);
      ctx.lineTo(pad.left, pad.top + ch);
      ctx.closePath();
      ctx.fillStyle = 'rgba(52,211,153,0.07)';
      ctx.fill();
    }
  }

  fetch('/content/files/kuma-status.json?t=' + Date.now())
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var beats = data.beats || [];
      setStatus(data.status === 1);
      document.getElementById('kuma-ping').textContent = data.ping != null ? data.ping : '—';
      document.getElementById('kuma-uptime24').textContent = data.uptime != null ? data.uptime + '%' : '—';
      if (beats.length) {
        setTimeout(function() {
          drawChart(document.getElementById('kuma-chart'), beats);
        }, 100);
      }
    })
    .catch(function() { setStatus(true); });
})();
</script>

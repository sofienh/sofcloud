<!DOCTYPE html>
<html lang="{{@site.locale}}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>
  <style>html,body{background:#03010a;color:#f1f5f9;margin:0}</style>
  <script>
  window.sofStill = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Image suivante d'une animation d'étoiles, mise en pause tant que le canvas est hors de l'écran
  window.sofNext = function (c, fn) {
    if (!c.sofIO && 'IntersectionObserver' in window) {
      c.sofIO = new IntersectionObserver(function (e) {
        c.sofOff = !e[0].isIntersecting;
        if (!c.sofOff && c.sofWait) { var f = c.sofWait; c.sofWait = null; requestAnimationFrame(f); }
      });
      c.sofIO.observe(c);
    }
    // Pendant le chargement : une seule image, l'animation démarre 2,5 s après « load »
    // (moins de travail pendant que la page s'affiche)
    if (!window.sofGo) { if (!c.sofHold) (window.sofHeld = window.sofHeld || []).push(c); c.sofHold = fn; return; }
    if (c.sofOff) c.sofWait = fn; else requestAnimationFrame(fn);
  };
  window.addEventListener('load', function () {
    setTimeout(function () {
      window.sofGo = true;
      document.documentElement.classList.add('sof-go');
      (window.sofHeld || []).forEach(function (c) { var f = c.sofHold; c.sofHold = null; if (f) window.sofNext(c, f); });
    }, 2500);
  });
  </script>
  {{ghost_head exclude="card_assets,search"}}
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preload" href="/assets/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{asset "css/style.css"}}">
  <link rel="icon" type="image/svg+xml" href="{{asset "favicon.svg"}}">
</head>
<body class="{{body_class}}">

{{> header}}

{{{body}}}

{{> footer}}

<button id="back-to-top" aria-label="Retour en haut" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

<style>
#back-to-top {
  position: fixed; bottom: 1.75rem; right: 1.75rem; z-index: 999;
  width: 2.5rem; height: 2.5rem; border-radius: 50%;
  background: var(--accent, #34d399); color: #080e0b;
  border: none; font-size: 1.1rem; font-weight: 700;
  cursor: pointer; opacity: 0; pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
  display: flex; align-items: center; justify-content: center;
}
#back-to-top.visible { opacity: 0.85; pointer-events: auto; }
#back-to-top:hover { opacity: 1; transform: translateY(-3px); }
</style>

<script>
(function () {
  var btn = document.getElementById('back-to-top');
  window.addEventListener('scroll', function () {
    btn.classList.toggle('visible', window.scrollY > 400);
    if (window._sofLoad) { window._sofLoad(); }
  }, { passive: true });
})();
</script>

<script>
(function () {
  document.addEventListener('click', function (e) {
    var link = e.target.closest('a[href]');
    if (!link) return;
    var href = link.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('mailto') || href.startsWith('tel') || link.target === '_blank' || e.ctrlKey || e.metaKey) return;
    if (href.startsWith('http')) { try { var u = new URL(href); if (u.hostname !== window.location.hostname) return; } catch(e) { return; } }
    e.preventDefault();
    document.body.style.transition = 'opacity 0.28s ease';
    document.body.style.opacity = '0';
    setTimeout(function () { window.location.href = href; }, 290);
  });
})();
</script>

<script>
/* « Lab Notes #NN — Titre » → numéro au-dessus, titre en dessous */
(function () {
  var re = /^\s*(Lab Notes #\d+)\s*[\u2014\u2013-]\s*(.+)$/;
  document.querySelectorAll('.post-title, .post-card-title').forEach(function (el) {
    var m = re.exec(el.textContent);
    if (!m) return;
    var k = document.createElement('span'); k.className = 'ln-kicker'; k.textContent = m[1];
    var t = document.createElement('span'); t.className = 'ln-title'; t.textContent = m[2];
    el.textContent = ''; el.appendChild(k); el.appendChild(t);
    el.classList.add('ln-split');
  });
})();
</script>

<script>
/* Lab notes, typographie : pas de mot court orphelin en fin de ligne.
   1. un mot court qui ouvre une phrase (« J'ai », « Le », « Il »…) reste collé au mot suivant ;
   2. sans « text-wrap: pretty » (Firefox), les deux derniers mots du paragraphe sont liés.
   Espaces insécables ajoutées au rendu, le texte en base n'est pas modifié. */
(function () {
  if (!document.body.classList.contains('tag-lab-notes')) return;
  var pretty = window.CSS && CSS.supports('text-wrap', 'pretty');
  document.querySelectorAll('.post-content :is(p, li, dd, figcaption)').forEach(function (el) {
    var w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null), n, last = null;
    while ((n = w.nextNode())) {
      if (n.parentNode.closest('code, pre')) continue;
      n.nodeValue = n.nodeValue.replace(/(^|[.!?:»]\s+)([^\s]{1,4})[ \t\n]+(?=\S)/g, '$1$2\u00A0');
      if (/\S\s+\S/.test(n.nodeValue)) last = n;
    }
    if (!pretty && last) last.nodeValue = last.nodeValue.replace(/(\S)[ \t\n]+(\S+\s*)$/, '$1\u00A0$2');
  });
})();
</script>
{{ghost_foot}}
</body>
</html>

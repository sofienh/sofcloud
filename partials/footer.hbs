<!-- RGPD Cookie Banner -->
<div id="rgpd-banner" class="rgpd-banner" role="dialog" aria-label="Gestion des cookies">
  <p class="rgpd-banner-text">
    🍪 Avec votre accord, ce site utilise Google Analytics pour mesurer son audience. Tant que vous n'avez pas accepté, aucun outil de mesure n'est chargé et aucune donnée n'est envoyée, conformément au <strong>RGPD</strong>.
  </p>
  <div class="rgpd-banner-actions">
    <button class="rgpd-btn-refuse" onclick="rgpdRefuse()">Refuser</button>
    <button class="rgpd-btn-accept" onclick="rgpdAccept()">Accepter</button>
  </div>
</div>

<script data-cfasync="false">
/* RGPD — Google Tag Manager n'est chargé QU'APRÈS un clic sur « Accepter »
   (ou si le visiteur avait déjà accepté). Sans accord : aucun script Google, aucune requête. */
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
gtag('consent', 'default', {
  analytics_storage: 'denied', ad_storage: 'denied',
  ad_user_data: 'denied', ad_personalization: 'denied'
});

function _rgpdGet() { try { return localStorage.getItem('rgpd-consent'); } catch (e) { return null; } }
function _rgpdSet(v) { try { localStorage.setItem('rgpd-consent', v); } catch (e) {} }

function sofLoadAnalytics() {
  if (window._sofGtmLoaded) return;
  window._sofGtmLoaded = true;
  gtag('consent', 'update', { analytics_storage: 'granted' });   // publicité : reste refusée
  dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
  var s = document.createElement('script');
  s.async = true;
  s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5N7NRJ9M';
  document.head.appendChild(s);
}

function _rgpdClearCookies() {
  // retrait du consentement : supprimer les cookies Google Analytics (_ga, _ga_*, _gid)
  document.cookie.split(';').forEach(function (c) {
    var name = c.split('=')[0].trim();
    if (/^_ga($|_)|^_gid$/.test(name)) {
      ['', '; domain=' + location.hostname, '; domain=.' + location.hostname.replace(/^www\./, '')].forEach(function (d) {
        document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
      });
    }
  });
}

function rgpdAccept() {
  _rgpdSet('accepted');
  document.getElementById('rgpd-banner').classList.remove('visible');
  sofLoadAnalytics();
}
function rgpdRefuse() {
  _rgpdSet('refused');
  document.getElementById('rgpd-banner').classList.remove('visible');
  if (window._sofGtmLoaded) gtag('consent', 'update', { analytics_storage: 'denied' });
  _rgpdClearCookies();
}

(function () {
  var consent = _rgpdGet();
  if (consent === 'accepted') sofLoadAnalytics();
  else if (!consent) document.getElementById('rgpd-banner').classList.add('visible');
})();
</script>

<!-- Aria-label SofBot — inline, actif dès le chargement -->
<script>
(function() {
  var LABEL = 'Ouvrir SofBot';
  function _apply(sr) {
    var btn = sr.querySelector('button[part="button"]');
    if (btn && btn.getAttribute('aria-label') !== LABEL) btn.setAttribute('aria-label', LABEL);
  }
  function _watch(host) {
    var sr = host.shadowRoot;
    if (!sr || sr._sofwatched) return;
    sr._sofwatched = true;
    _apply(sr);
    new MutationObserver(function() { _apply(sr); }).observe(sr, { childList: true, subtree: true });
  }
  new MutationObserver(function(muts) {
    muts.forEach(function(m) {
      m.addedNodes.forEach(function(n) {
        if (n.nodeType !== 1) return;
        if (n.shadowRoot) _watch(n);
        var els = n.querySelectorAll('*');
        for (var i = 0; i < els.length; i++) { if (els[i].shadowRoot) _watch(els[i]); }
      });
    });
  }).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>

<!-- SofBot — chargé après première interaction (lazy) -->
<script>
(function() {
  var _loaded = false;
  function _load() {
    if (_loaded) return; _loaded = true;
    window._sofLoad = null;
    var s = document.createElement('script');
    s.type = 'module';
    s.src = '{{asset "js/sofbot.js"}}';
    document.body.appendChild(s);
  }
  window._sofLoad = _load;
  ['click','touchstart','keydown'].forEach(function(e) {
    window.addEventListener(e, _load, { once: true, passive: true });
  });
  setTimeout(_load, 4000);
})();
</script>

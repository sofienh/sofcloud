</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  {{#each @site.navigation}}
  <a href="{{this.url}}" class="mobile-nav-link" onclick="closeMobileMenu()">{{label}}</a>
  {{/each}}
  <a href="/lab-notes/" class="mobile-nav-link" onclick="closeMobileMenu()">Lab Notes</a>
  <a href="/a-propos/" class="mobile-nav-cta" onclick="closeMobileMenu()">À propos</a>
</div>

<script>
(function() {
  var btn = document.getElementById('navHamburger');
  var menu = document.getElementById('mobileMenu');
  btn.addEventListener('click', function() {
    var open = menu.classList.toggle('open');
    btn.classList.toggle('open');
    btn.setAttribute('aria-expanded', open);
    menu.setAttribute('aria-hidden', !open);
  });
  window.closeMobileMenu = function() {
    menu.classList.remove('open');
    btn.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
    menu.setAttribute('aria-hidden', 'true');
  };
  document.addEventListener('click', function(e) {
    if (!btn.contains(e.target) && !menu.contains(e.target)) closeMobileMenu();
  });

  // Dropdown Lab Notes
  var wrap = document.querySelector('.nav-dropdown-wrap');
  if (wrap) {
    var closeTimer;
    wrap.addEventListener('mouseenter', function() { clearTimeout(closeTimer); wrap.classList.add('open'); });
    wrap.addEventListener('mouseleave', function() { closeTimer = setTimeout(function() { wrap.classList.remove('open'); }, 120); });
    document.addEventListener('click', function(e) {
      if (!wrap.contains(e.target)) wrap.classList.remove('open');
    });
  }

  // Couleurs par page
  var NAV_COLORS = {
    '/':              '#34d399',
    '/experiences/':  '#60a5fa',
    '/competences/':  '#a78bfa',
    '/projets/':      '#fbbf24',
    '/veille/':       '#fb923c',
    '/a-propos/':     '#22d3ee',
    '/lab-notes/': '#fb7185'
  };
  document.querySelectorAll('.nav-link, .mobile-nav-link').forEach(function(link) {
    var path = new URL(link.href, window.location.origin).pathname;
    var color = NAV_COLORS[path];
    if (!color) return;
    link.addEventListener('mouseenter', function() { link.style.color = color; });
    link.addEventListener('mouseleave', function() { link.style.color = ''; });
  });
})();
</script>

<style>
.nav-brand-sep { opacity: 0.4; }
@media (max-width: 900px) { .nav-brand-role { display: none; } }
.nav-dropdown-wrap { position: relative; display: inline-flex; align-items: center; }
.nav-caret { font-size: 0.65em; margin-left: 0.2em; opacity: 0.7; transition: transform 0.2s; display: inline-block; }
.nav-dropdown-wrap.open .nav-caret { transform: rotate(180deg); }
.nav-dropdown-wrap::after {
  content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 0.6rem;
}
.nav-dropdown-menu {
  display: none; position: absolute; top: calc(100% + 0.6rem); left: 50%;
  transform: translateX(-50%); min-width: 230px;
  background: #0f1a14; border: 1px solid #1a2d22; border-radius: 10px;
  padding: 0.4rem 0; list-style: none; margin: 0;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4); z-index: 999;
}
.nav-dropdown-wrap.open .nav-dropdown-menu { display: block; }
.nav-dropdown-menu li a {
  display: block; padding: 0.5rem 1rem;
  font-family: 'DM Mono', monospace; font-size: 0.78rem; color: #94a3b8;
  text-decoration: none; white-space: nowrap; transition: color 0.15s, background 0.15s;
}
.nav-dropdown-menu li a:hover { color: #e879f9; background: rgba(232,121,249,0.06); }
.mobile-nav-section-label {
  font-family: 'DM Mono', monospace; font-size: 0.65rem; text-transform: uppercase;
  letter-spacing: 0.1em; color: #e879f9; padding: 0.75rem 1.5rem 0.25rem; opacity: 0.8;
}
.mobile-nav-sub { padding-left: 2rem !important; font-size: 0.82rem !important; color: #64748b !important; }
.mobile-nav-sub:hover { color: #e879f9 !important; }
</style>

{{!< default}}
<style>
:root {
  --accent: #a78bfa; --accent-light: #c4b5fd; --accent-dim: rgba(167,139,250,0.1);
  --border: #2d1a40; --surface: #150d1f; --surface2: #1e1030;
}
</style>
<main class="site-content">
  <a href="{{@site.url}}" class="back-link">← Retour</a>

  <div class="page-header">
    <div class="section-label">02 — Compétences</div>
  </div>

  <div class="skills-grid">

    <div class="skill-item">
      <div class="skill-item-icon">🛡️</div>
      <div class="skill-item-name">Cybersécurité</div>
      <div class="skill-item-desc">SOC, IDS/IPS, audit sécurité, SIEM Wazuh (XDR), analyse des risques EBIOS Risk Manager, tableaux de bord sécurité, maintenance SIEM</div>
      <div class="tags">
        <span class="tag">CrowdSec</span><span class="tag">Wazuh XDR</span><span class="tag">EBIOS RM</span><span class="tag">Kali Linux</span><span class="tag">PingCastle</span><span class="tag">Exogol</span><span class="tag">Auditd</span><span class="tag">rkhunter</span><span class="tag">iptables</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">🌐</div>
      <div class="skill-item-name">Réseaux &amp; Infrastructure</div>
      <div class="skill-item-desc">LAN/WLAN, VPN, routage, switching, VLSM, câblage structuré, tolérance de pannes, Plan de Reprise d'Activité (PRA), vidéosurveillance. Déploiement Edge Core (Madrid).</div>
      <div class="tags">
        <span class="tag">WireGuard</span><span class="tag">Nginx</span><span class="tag">DNS/DHCP</span><span class="tag">VLAN/VLSM</span><span class="tag">LAN/MAN/WAN</span><span class="tag">LDAP</span><span class="tag">Samba 4</span><span class="tag">RAID</span><span class="tag">Edge Core</span><span class="tag">PRA</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">🐳</div>
      <div class="skill-item-name">DevOps &amp; Cloud</div>
      <div class="skill-item-desc">Containerisation Docker, monitoring Grafana/Prometheus, Oracle Cloud ARM64, Nextcloud, pipelines CI/CD, déploiement automatisé.</div>
      <div class="tags">
        <span class="tag">Docker</span><span class="tag">Portainer</span><span class="tag">Grafana</span><span class="tag">Prometheus</span><span class="tag">Nextcloud</span><span class="tag">CI/CD</span><span class="tag">Oracle Cloud</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">🖥️</div>
      <div class="skill-item-name">Systèmes</div>
      <div class="skill-item-desc">Administration Linux/Windows Server, virtualisation Proxmox/VMware, GPO, GLPI, IT Asset Management</div>
      <div class="tags">
        <span class="tag">Debian</span><span class="tag">Ubuntu</span><span class="tag">FreeNAS</span><span class="tag">Windows Server</span><span class="tag">GPO/AD DS</span><span class="tag">Shell Script</span><span class="tag">Proxmox</span><span class="tag">VMware</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">📋</div>
      <div class="skill-item-name">Management de Projet</div>
      <div class="skill-item-desc">Pilotage de projets IT de bout en bout : étude avant-projet, planification, suivi/contrôle, clôture. Gestion des risques, rédaction d'appels d'offres et cahiers des charges, gestion des coûts et de la recette.</div>
      <div class="tags">
        <span class="tag">Chef de projet</span><span class="tag">Étude avant-projet</span><span class="tag">Gestion des risques</span><span class="tag">Gestion des coûts</span><span class="tag">Appels d'offres</span><span class="tag">Cahier des charges</span><span class="tag">Reporting</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">🔐</div>
      <div class="skill-item-name">IAM &amp; ITSM</div>
      <div class="skill-item-desc">Identity and Access Management (IAM) : gouvernance des accès, MFA, SSO, annuaires. ITIL/ITSM : gestion des incidents, problèmes et changements, mise en place GLPI, KPIs support IT.</div>
      <div class="tags">
        <span class="tag">IAM</span><span class="tag">ITIL</span><span class="tag">ITSM</span><span class="tag">GLPI</span><span class="tag">Gestion des incidents</span><span class="tag">MFA/SSO</span><span class="tag">Active Directory</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">👥</div>
      <div class="skill-item-name">Management des Hommes</div>
      <div class="skill-item-desc">Leadership, animation d'équipe, Communication Non-Violente (CNV), gestion des conflits, profils comportementaux (DISC 4 couleurs), assertivité. Esprit d'équipe, écoute active, pédagogie.</div>
      <div class="tags">
        <span class="tag">Leadership</span><span class="tag">Gestion d'équipe</span><span class="tag">CNV</span><span class="tag">Gestion des conflits</span><span class="tag">DISC 4 couleurs</span><span class="tag">Assertivité</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">⚡</div>
      <div class="skill-item-name">Télécom &amp; Datacenter</div>
      <div class="skill-item-desc">Baies, câblage, Oracle Tekelec Eagle 5, Anritsu (Bucarest), signalétique datacenter. Déploiements Orange national (Île-de-France, Lyon, Marseille, Toulouse, Metz). IPTV Hoist Group (Copenhague).</div>
      <div class="tags">
        <span class="tag">Oracle Tekelec</span><span class="tag">Anritsu</span><span class="tag">Polycom</span><span class="tag">Câblage structuré</span><span class="tag">Datacenter</span><span class="tag">IPTV</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">💻</div>
      <div class="skill-item-name">Scripting &amp; Automatisation</div>
      <div class="skill-item-desc">Scripting Bash, automatisation d'infrastructure, développement d'outils internes (Node.js, Express, MongoDB). Intégration d'APIs, traitement de données, génération de rapports automatisés.</div>
      <div class="tags">
        <span class="tag">Bash</span><span class="tag">Node.js</span><span class="tag">JavaScript</span><span class="tag">Python</span><span class="tag">Automatisation</span><span class="tag">APIs</span>
      </div>
    </div>

    <div class="skill-item">
      <div class="skill-item-icon">🤝</div>
      <div class="skill-item-name">Compétences transversales</div>
      <div class="skill-item-desc">Force de proposition, autonomie, prise d'initiative, rigueur, gestion du stress, organisation, sens du relationnel, éthique professionnelle. Rédaction technique, conduite du changement.</div>
      <div class="tags">
        <span class="tag">Force de proposition</span><span class="tag">Autonomie</span><span class="tag">Prise d'initiative</span><span class="tag">Conduite du changement</span><span class="tag">Rédaction technique</span><span class="tag">Travail en équipe</span>
      </div>
    </div>

  </div>

  <div class="sc-langues">
    <div class="section-label" style="margin-top:3rem; margin-bottom:1.5rem;">Langues</div>
    <div class="langues-grid">
      <div class="langue-item">
        <span class="langue-flag">🇫🇷</span>
        <span class="langue-name">Français</span>
        <div class="langue-bar"><div class="langue-fill" style="width:100%"></div></div>
        <span class="langue-level">Natif</span>
      </div>
      <div class="langue-item">
        <span class="langue-flag">🇬🇧</span>
        <span class="langue-name">Anglais</span>
        <div class="langue-bar"><div class="langue-fill" style="width:70%"></div></div>
        <span class="langue-level">B2 — Professionnel</span>
      </div>
      <div class="langue-item">
        <span class="langue-flag">🇹🇳</span>
        <span class="langue-name">Arabe</span>
        <div class="langue-bar"><div class="langue-fill" style="width:100%"></div></div>
        <span class="langue-level">Natif</span>
      </div>
    </div>
  </div>

  <style>
  .langues-grid { display: flex; flex-direction: column; gap: 1rem; max-width: 480px; }
  .langue-item { display: grid; grid-template-columns: 1.5rem 7rem 1fr 9rem; align-items: center; gap: 1rem; }
  .langue-flag { font-size: 1.1rem; }
  .langue-name { font-size: 0.9rem; font-weight: 500; }
  .langue-bar { height: 4px; background: var(--border, #1a2d22); border-radius: 2px; overflow: hidden; }
  .langue-fill { height: 100%; background: var(--accent, #10b981); border-radius: 2px; }
  .langue-level { font-family: var(--mono, monospace); font-size: 0.72rem; color: var(--text-muted, #64748b); }
  @media (max-width: 480px) { .langue-item { grid-template-columns: 1.5rem 5rem 1fr; } .langue-level { display: none; } }
  </style>

</main>

{{!< default}}

<main class="site-content">
  {{#tag}}
  <div class="tag-header fade-in">
    <div class="section-label">Tag</div>
    <h1 class="tag-name">#{{name}}</h1>
    {{#if description}}
    <p class="tag-desc">{{description}}</p>
    {{/if}}
    <p class="tag-count">{{plural ../pagination.total empty="Aucun article" singular="% article" plural="% articles"}}</p>
  </div>
  {{/tag}}

  <div class="post-feed">
    {{#foreach posts}}
    {{> post-card}}
    {{else}}
    <p style="color:var(--text-muted);font-family:var(--mono);font-size:0.9rem">Aucun article dans cette catégorie.</p>
    {{/foreach}}
  </div>

  {{pagination}}
</main>
